    "test:pi-rpc": "node tools/unit/pi-rpc-test.mjs",
    "test:pi-cancel": "node tools/live/pi-cancel-test.mjs",
    "test:compaction": "node tools/unit/compaction-test.mjs",
    "test:dispatcher-compact": "node tools/unit/dispatcher-compact-test.mjs",
    "test:pieces": "node tools/unit/pieces-test.mjs",
    "test:rules": "node tools/unit/rules-test.mjs",
    "test:isolated": "node tools/ops/run-isolated.mjs",
    "test:templates": "node tools/live/templates-test.mjs",
    "test:data-layout": "node tools/unit/data-layout-test.mjs",
