{
  "name": "@speclock-scaffold/agentd",
  "version": "1.0.0",
  "private": true,
  "description": "Resident multi-agent scheduler for pi: agentd daemon + pi extension, driven over ACP.",
  "type": "module",
  "exports": {
    "./client": "./client/index.mjs"
  },
  "scripts": {
    "daemon": "node daemon/agentd.mjs",
    "daemon:stop": "powershell -NoProfile -Command \"Get-CimInstance Win32_Process -Filter \\\"Name='node.exe'\\\" | Where-Object { $_.CommandLine -like '*agentd.mjs*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }\"",
    "daemon:log": "powershell -NoProfile -Command \"Get-Content -Wait -Tail 40 data/global/agentd.log\"",
    "test": "node scripts/run-isolated.mjs",
    "test:backend": "npm run test:raw -w @speclock-scaffold/backend",
    "test:all": "npm run test:daemon && npm run test:events && npm run test:switch && npm run test:models && npm run test:health && npm run test:stream && npm run test:models-json && npm run test:transcript && npm run test:dispatcher && npm run test:projects && npm run test:start && npm run test:idle && npm run test:stuck-tool && npm run test:forced && npm run test:interrupted && npm run test:reply && npm run test:tasks && npm run test:handoff-prompts && npm run test:queue && npm run test:prompt-queue && npm run test:run-tracker && npm run test:ops && npm run test:provider && npm run test:dispatcher-provider && npm run test:llm-test && npm run test:block-sessions && npm run test:layers && npm run test:router && npm run test:reports && npm run test:reports-live && npm run test:shutdown && npm run test:dispatcher-sessions && npm run test:turn-queue && npm run test:dispatcher-context && npm run test:transport && npm run test:acp-small && npm run test:acp-runs && npm run test:acp-sessions && npm run test:dispatcher-queue && npm run test:pi-rpc && npm run test:compaction && npm run test:dispatcher-compact && npm run test:pieces && npm run test:rules && npm run test:templates && npm run test:data-layout && npm run test:mcp && npm run test:install && npm run test:specs && npm run test:specs-locate && npm run test:nudge",
    "test:daemon": "node test/live/daemon-share-test.mjs dsh",
    "test:switch": "node test/live/session-switch-test.mjs dsh",
    "test:models": "node test/live/model-persist-test.mjs dsh",
    "test:stream": "node test/live/stream-test.mjs pi",
    "test:health": "node test/live/health-test.mjs dsh",
    "test:events": "node test/live/events-test.mjs dsh",
    "test:models-json": "node test/unit/pi-models-test.mjs",
    "test:transcript": "node test/live/transcript-test.mjs dsh",
    "test:dispatcher": "node test/live/dispatcher-test.mjs",
    "test:projects": "node test/live/projects-test.mjs dsh",
    "test:start": "node test/unit/start-retry-test.mjs",
    "test:idle": "node test/unit/idle-timeout-test.mjs",
    "test:forced": "node test/unit/forced-stop-test.mjs",
    "test:interrupted": "node test/live/interrupted-test.mjs",
    "test:reply": "node test/unit/reply-test.mjs",
    "test:tasks": "node test/live/tasks-test.mjs",
    "test:handoff-prompts": "node test/unit/handoff-prompts-test.mjs",
    "test:queue": "node test/unit/queue-test.mjs",
    "test:prompt-queue": "node test/unit/prompt-queue-test.mjs",
    "test:run-tracker": "node test/unit/run-tracker-test.mjs",
    "test:ops": "node test/unit/ops-test.mjs",
    "test:specs": "node test/live/specs-live-test.mjs",
    "test:specs-locate": "node test/unit/specs-locate-test.mjs",
    "test:nudge": "node test/unit/nudge-test.mjs",
    "test:layers": "node test/unit/layers-test.mjs",
    "test:router": "node test/unit/router-test.mjs",
    "test:extension-live": "node test/live/dispatcher-tools-live-test.mjs",
    "test:shutdown": "node test/live/daemon-shutdown-test.mjs",
    "restart-daemon": "node scripts/restart-daemon.mjs",
    "test:dispatcher-sessions": "node test/unit/dispatcher-sessions-test.mjs",
    "test:turn-queue": "node test/unit/turn-queue-test.mjs",
    "test:dispatcher-context": "node test/unit/dispatcher-context-test.mjs",
    "test:transport": "node test/unit/acp-transport-test.mjs",
    "test:acp-small": "node test/unit/acp-small-parts-test.mjs",
    "test:acp-runs": "node test/unit/acp-runs-test.mjs",
    "test:acp-sessions": "node test/unit/acp-sessions-test.mjs",
    "test:dispatcher-queue": "node test/unit/dispatcher-queue-test.mjs",
    "test:pi-rpc": "node test/unit/pi-rpc-test.mjs",
    "test:pi-cancel": "node test/live/pi-cancel-test.mjs",
    "test:compaction": "node test/unit/compaction-test.mjs",
    "test:dispatcher-compact": "node test/unit/dispatcher-compact-test.mjs",
    "test:pieces": "node test/unit/pieces-test.mjs",
    "test:rules": "node test/unit/rules-test.mjs",
    "test:isolated": "node scripts/run-isolated.mjs",
    "test:templates": "node test/live/templates-test.mjs",
    "test:data-layout": "node test/unit/data-layout-test.mjs",
    "test:mcp": "node test/unit/mcp-test.mjs",
    "test:mcp-live": "node test/live/mcp-live-test.mjs",
    "test:install": "node test/unit/install-test.mjs",
    "test:provider": "node test/unit/provider-test.mjs",
    "test:llm-test": "node test/unit/llm-test-test.mjs",
    "test:provider-live": "node test/live/provider-live-test.mjs",
    "test:dispatcher-provider": "node test/live/dispatcher-provider-test.mjs",
    "test:block-sessions": "node test/live/block-sessions-test.mjs",
    "test:executors-live": "node test/live/executors-live-test.mjs",
    "test:dispatcher-live": "node test/live/dispatcher-live-test.mjs",
    "test:stop-guard": "node test/live/stop-guard-test.mjs",
    "test:reports": "node test/unit/reports-test.mjs",
    "test:dispatcher-report": "node test/live/dispatcher-test.mjs --prompt",
    "test:reports-live": "node test/live/reports-live-test.mjs",
    "test:stuck-tool": "node test/unit/stuck-tool-test.mjs"
  },
  "dependencies": {
    "@speclock-scaffold/drivers": "*"
  }
}
