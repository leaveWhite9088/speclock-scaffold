    "test:prompt-queue": "node tools/unit/prompt-queue-test.mjs",
    "test:run-tracker": "node tools/unit/run-tracker-test.mjs",
    "test:ops": "node tools/unit/ops-test.mjs",
    "test:layers": "node tools/unit/layers-test.mjs",
    "test:router": "node tools/unit/router-test.mjs",
    "test:extension-live": "node tools/live/dispatcher-tools-live-test.mjs",
    "test:shutdown": "node tools/live/daemon-shutdown-test.mjs",
    "restart-daemon": "node tools/ops/restart-daemon.mjs",
    "test:dispatcher-sessions": "node tools/unit/dispatcher-sessions-test.mjs",
    "test:turn-queue": "node tools/unit/turn-queue-test.mjs",
    "test:dispatcher-context": "node tools/unit/dispatcher-context-test.mjs",
