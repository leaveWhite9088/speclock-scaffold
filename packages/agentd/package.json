{
  "name": "@speclock-scaffold/agentd",
  "version": "1.0.0",
  "private": true,
  "description": "Resident multi-agent scheduler for pi: agentd daemon + pi extension, driven over ACP.",
  "type": "module",
  "scripts": {
    "daemon": "node daemon/agentd.mjs",
    "daemon:stop": "powershell -NoProfile -Command \"Get-CimInstance Win32_Process -Filter \\\"Name='node.exe'\\\" | Where-Object { $_.CommandLine -like '*agentd.mjs*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }\"",
    "daemon:log": "powershell -NoProfile -Command \"Get-Content -Wait -Tail 40 data/runtime/agentd.log\"",
    "test": "npm run test:daemon && npm run test:events && npm run test:switch && npm run test:models && npm run test:health && npm run test:stream && npm run test:cwd && npm run test:models-json && npm run test:instances && npm run test:transcript && npm run test:dispatcher && npm run test:projects && npm run test:start && npm run test:idle && npm run test:forced && npm run test:interrupted && npm run test:reply && npm run test:tasks && npm run test:handoff-prompts && npm run test:queue && npm run test:prompt-queue && npm run test:run-tracker && npm run test:ops && npm run test:layers && npm run test:router && npm run test:shutdown && npm run test:dispatcher-sessions && npm run test:turn-queue && npm run test:dispatcher-context && npm run test:transport && npm run test:acp-small && npm run test:acp-runs && npm run test:acp-sessions && npm run test:dispatcher-queue && npm run test:pi-rpc && npm run test:compaction && npm run test:dispatcher-compact && npm run test:pieces && npm run test:rules && npm run test:templates && npm run test:data-layout && npm run test:mcp",
    "test:daemon": "node tools/live/daemon-share-test.mjs dsh",
    "test:switch": "node tools/live/session-switch-test.mjs dsh",
    "test:models": "node tools/live/model-persist-test.mjs dsh",
    "test:stream": "node tools/live/stream-test.mjs pi",
    "test:health": "node tools/live/health-test.mjs dsh",
    "test:cwd": "node tools/live/cwd-test.mjs",
    "test:events": "node tools/live/events-test.mjs dsh",
    "test:models-json": "node tools/unit/pi-models-test.mjs",
    "test:instances": "node tools/live/instances-test.mjs dsh",
    "test:transcript": "node tools/live/transcript-test.mjs dsh",
    "test:dispatcher": "node tools/live/dispatcher-test.mjs",
    "test:projects": "node tools/live/projects-test.mjs dsh",
    "test:start": "node tools/unit/start-retry-test.mjs",
    "test:idle": "node tools/unit/idle-timeout-test.mjs",
    "test:forced": "node tools/unit/forced-stop-test.mjs",
    "test:interrupted": "node tools/live/interrupted-test.mjs",
    "test:reply": "node tools/unit/reply-test.mjs",
    "test:tasks": "node tools/live/tasks-test.mjs",
    "test:handoff-prompts": "node tools/unit/handoff-prompts-test.mjs",
